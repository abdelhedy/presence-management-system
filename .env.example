# Copier ce fichier en .env et adapter les valeurs.
# Ne jamais versionner le fichier .env.

# Application
APP_URL=http://localhost/presence-management-system
# true = afficher le détail des erreurs (développement uniquement)
APP_DEBUG=false

# Base de données
DB_HOST=localhost
DB_NAME=systeme_presence
DB_USER=root
DB_PASSWORD=

# Compte administrateur initial (utilisé par scripts/insert_admin.php)
ADMIN_EMAIL=admin@presence.com
ADMIN_PASSWORD=

# Interpréteur Python pour la reconnaissance faciale (optionnel)
# Par défaut : le .venv du projet s'il existe, sinon python (Windows) / python3
# Exemple : PYTHON_BIN=C:\Users\moi\AppData\Local\Programs\Python\Python310\python.exe
PYTHON_BIN=
